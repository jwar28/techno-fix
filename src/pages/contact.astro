---
import Layout from '../layouts/Layout.astro';
import Contacto from '../components/Contacto.astro';
import OrdenServicio from '../components/OrdenServicio.jsx';
---

<Layout
  title='Contacto'
  description='Escríbele a TecnoFix por WhatsApp o llama para agendar tu diagnóstico gratis a domicilio en Barranquilla.'>
  <section
    class='mx-auto grid max-w-page gap-x-12 gap-y-14 px-4 pb-24 pt-10 sm:px-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,560px)] lg:pt-14'>
    <div>
      <h1 class='display text-[clamp(48px,7.5vw,96px)] text-white'>
        Llámanos o escríbenos
      </h1>
      <p class='mb-10 mt-6 max-w-[44ch] text-[19px] leading-relaxed text-fog'>
        La forma más rápida es WhatsApp: llena la orden y nos llega con tu
        equipo, el problema y el precio estimado.
      </p>
      <div class='[&_ul]:sm:grid-cols-1'>
        <Contacto />
      </div>
    </div>
    <OrdenServicio client:load />
  </section>
</Layout>
