---
// Seguimiento de la orden: el proceso son los estados que la misma orden va marcando.
const estados = [
  {
    estado: 'Recibida',
    texto: 'Nos llega tu orden por WhatsApp con el equipo y lo que le pasa.',
  },
  {
    estado: 'Diagnosticada',
    texto: 'El técnico revisa el equipo y te confirma el precio antes de empezar.',
    sello: 'Gratis',
  },
  {
    estado: 'Reparada',
    texto: 'Hacemos la reparación o el mantenimiento en tu casa, sin que salgas.',
  },
  {
    estado: 'En garantía',
    texto: 'Tu reparación tiene garantía. Pregúntanos las condiciones por WhatsApp.',
    sello: 'Garantía',
  },
];
---

<div class='paper perforated'>
  <p class='border-b-2 border-ink px-5 py-3 sm:px-8'>
    <span class='field-label'>Seguimiento de la orden</span>
  </p>
  <ol class='grid sm:grid-cols-2 lg:grid-cols-4'>
    {
      estados.map((e, i) => (
        <li class='relative border-paper-rule px-5 py-6 sm:px-8 [&:not(:last-child)]:border-b sm:[&:nth-child(odd)]:border-r lg:border-b-0 lg:[&:not(:last-child)]:border-r'>
          <span class='flex min-h-[32px] items-center justify-between gap-3'>
            <span
              class='grid h-7 w-7 shrink-0 place-items-center border-[1.5px] border-ink bg-ink text-paper'
              aria-hidden='true'>
              <svg width='14' height='14' viewBox='0 0 14 14'>
                <path d='M1.5 7.5l3.5 3.5L12.5 3' fill='none' stroke='currentColor' stroke-width='2.2' />
              </svg>
            </span>
            {e.sello && (
              <span class='-rotate-[4deg] border-2 border-stamp px-2.5 py-1 text-[15px] font-black uppercase leading-none tracking-[0.04em] text-stamp outline outline-1 outline-offset-2 outline-stamp' style='font-stretch:75%'>
                {e.sello}
              </span>
            )}
          </span>
          <h3 class='mt-5 text-[30px] font-black uppercase leading-none' style='font-stretch:75%'>
            {e.estado}
          </h3>
          <p class='mt-3 max-w-[30ch] text-[16px] leading-relaxed text-[#3d4340]'>{e.texto}</p>
        </li>
      ))
    }
  </ol>
</div>
