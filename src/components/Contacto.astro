---
import { Icon } from 'astro-icon/components';
import {
  INSTAGRAM_HANDLE,
  INSTAGRAM_URL,
  PHONE_DISPLAY,
  PHONE_TEL,
  WHATSAPP_DISPLAY,
  whatsappLink,
} from '../data/services';

const canales = [
  {
    icon: 'whatsapp',
    label: 'WhatsApp',
    value: WHATSAPP_DISPLAY,
    href: whatsappLink('Hola TecnoFix, quiero cotizar una reparación.'),
    external: true,
    primary: true,
  },
  { icon: 'phone', label: 'Teléfono', value: PHONE_DISPLAY, href: `tel:${PHONE_TEL}` },
  {
    icon: 'instagram',
    label: 'Instagram',
    value: INSTAGRAM_HANDLE,
    href: INSTAGRAM_URL,
    external: true,
  },
];
---

<ul class='grid gap-3 sm:grid-cols-3'>
  {
    canales.map((c) => (
      <li>
        <a
          href={c.href}
          target={c.external ? '_blank' : undefined}
          rel={c.external ? 'noopener' : undefined}
          class:list={[
            'flex h-full min-h-[88px] items-center gap-4 px-5 py-4 no-underline transition-colors duration-150',
            c.primary
              ? 'bg-paper text-ink hover:bg-mint'
              : 'border-[1.5px] border-fog/60 text-white hover:border-white hover:bg-white/10',
          ]}>
          <Icon name={c.icon} class='h-7 w-7 shrink-0' aria-hidden='true' />
          <span>
            <span class='block text-[14px] font-semibold uppercase tracking-[0.1em] opacity-80'>
              {c.label}
            </span>
            <span class='num block text-[20px] font-bold'>{c.value}</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>
