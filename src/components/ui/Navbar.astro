---
import { Icon } from 'astro-icon/components';
import { WHATSAPP_DISPLAY, whatsappLink } from '../../data/services';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/services', label: 'Servicios y precios' },
  { href: '/#como-trabajamos', label: 'Cómo trabajamos' },
  { href: '/about', label: 'Nosotros' },
  { href: '/contact', label: 'Contacto' },
];
const isActive = (href: string) =>
  href !== '/' && !href.includes('#') && path.startsWith(href);
---

<header class='sticky top-0 z-40 border-b border-white/20 bg-mat'>
  <nav
    class='mx-auto flex h-[72px] max-w-page items-center justify-between gap-6 px-4 sm:px-8'
    aria-label='Principal'>
    <a href='/' class='flex items-center gap-3 text-white no-underline' aria-label='TecnoFix, inicio'>
      <span class='grid h-10 w-10 place-items-center rounded-full bg-white p-0.5'>
        <img src='/logo-96.png' alt='' width='36' height='36' class='h-9 w-9' />
      </span>
      <span class='text-[28px] font-black uppercase leading-none' style='font-stretch:80%'>
        Tecno<span class='text-mint'>Fix</span>
      </span>
    </a>

    <ul class='hidden items-center gap-8 lg:flex'>
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={isActive(l.href) ? 'page' : undefined}
              class:list={[
                'text-[16px] font-medium text-fog no-underline hover:text-white hover:underline',
                isActive(l.href) && 'text-white underline decoration-mint decoration-2',
              ]}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class='flex items-center gap-2'>
      <a
        href={whatsappLink('Hola TecnoFix, quiero cotizar una reparación.')}
        target='_blank'
        rel='noopener'
        class='inline-flex min-h-[44px] items-center gap-2 bg-paper px-3 py-2 text-[15px] font-bold text-ink no-underline transition-colors hover:bg-mint sm:px-4'>
        <Icon name='whatsapp' class='h-5 w-5' aria-hidden='true' />
        <span class='hidden sm:inline'>WhatsApp</span>
        <span class='num hidden md:inline'>{WHATSAPP_DISPLAY}</span>
      </a>
      <button
        type='button'
        class='grid h-11 w-11 place-items-center text-white lg:hidden'
        aria-controls='menu-movil'
        aria-expanded='false'
        data-menu-toggle>
        <span class='sr-only'>Abrir menú</span>
        <svg width='22' height='16' viewBox='0 0 22 16' aria-hidden='true'>
          <path d='M1 1h20M1 8h20M1 15h20' stroke='currentColor' stroke-width='2' stroke-linecap='square'></path>
        </svg>
      </button>
    </div>
  </nav>
  <div id='menu-movil' class='hidden border-t border-white/20 lg:hidden' data-menu>
    <ul class='mx-auto max-w-page px-4 py-2 sm:px-8'>
      {
        links.map((l) => (
          <li class='border-b border-white/10 last:border-0'>
            <a
              href={l.href}
              aria-current={isActive(l.href) ? 'page' : undefined}
              class='block py-4 text-[20px] font-semibold text-white no-underline'>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  function bindMenu() {
    const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    if (!btn || !menu) return;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      menu.classList.toggle('hidden', open);
    });
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        btn.setAttribute('aria-expanded', 'false');
        menu.classList.add('hidden');
      })
    );
  }
  document.addEventListener('astro:page-load', bindMenu);
</script>
