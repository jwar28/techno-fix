---
import { ViewTransitions } from 'astro:transitions';
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/courier-prime/400.css';
import '@fontsource/courier-prime/700.css';
import '../styles/global.css';
import Navbar from '../components/ui/Navbar.astro';
import Footer from '../components/ui/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Reparación de celulares, tabletas, consolas y computadores a domicilio en Barranquilla. Diagnóstico gratis, precios claros y garantía.',
} = Astro.props;
const fullTitle = title === 'Inicio' ? 'TecnoFix · Servicio técnico a domicilio en Barranquilla' : `${title} · TecnoFix`;
---

<!doctype html>
<html lang='es'>
  <head>
    <meta charset='UTF-8' />
    <meta name='description' content={description} />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <meta name='theme-color' content='#24575A' />
    <link rel='icon' type='image/png' href='/logo.png' />
    <link rel='sitemap' href='/sitemap-index.xml' />
    <meta property='og:title' content={fullTitle} />
    <meta property='og:description' content={description} />
    <meta property='og:locale' content='es_CO' />
    <meta name='generator' content={Astro.generator} />
    <title>{fullTitle}</title>
    <ViewTransitions />
  </head>
  <body class='min-h-screen flex flex-col'>
    <a
      href='#contenido'
      class='sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-paper focus:px-4 focus:py-3 focus:text-ink'
      >Saltar al contenido</a
    >
    <Navbar />
    <main id='contenido' class='flex-1'>
      <slot />
    </main>
    <Footer />
  </body>
</html>
